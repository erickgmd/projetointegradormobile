DATABASE_URL=postgresql://cashflow:cashflow_local@localhost:5433/cashflow
PORT=3001
HOST=127.0.0.1
NODE_ENV=development
# HTTPS em produção: configure o endereço público exato e NODE_ENV=production.
# APP_ORIGIN=https://seu-dominio.com
# DB_SSL=true

# Supabase: mantenha DB_SSL=true e informe o arquivo CA baixado no painel.
# DB_CA_FILE=./supabase-ca.crt
# Não precisa repetir NODE_EXTRA_CA_CERTS quando DB_CA_FILE estiver configurado.

APP_ORIGIN=http://localhost:3001
# App Android no emulador (Android Studio) acessa o computador por 10.0.2.2.
APP_EXTRA_ORIGINS=http://10.0.2.2:3001

# Login com Google: Client ID do tipo "Aplicativo da Web" (Google Cloud Console).
# O mesmo ID serve para o site e para o app Android. Vazio = botão avisa que falta configurar.
GOOGLE_CLIENT_ID=

# Recuperação de senha por email (SMTP). Exemplo com Gmail + "senha de app":
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=seuemail@gmail.com
# SMTP_PASSWORD=senha de app de 16 letras
# SMTP_FROM=CashFlow <seuemail@gmail.com>
# Sem SMTP (e fora de produção), o link de redefinição aparece no terminal do npm start.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Telegram: token do BotFather e segredo aleatório (ex.: 32bytes hex).
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
# Opcional: cache apenas do modelo de idioma OCR, nunca das imagens.
# OCR_CACHE_PATH=./.cache/ocr
# Produção atrás de proxy HTTPS confiável (não exponha Node diretamente):
# TRUST_PROXY=true
